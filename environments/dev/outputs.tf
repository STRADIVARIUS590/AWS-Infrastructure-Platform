output "aws_account_id" {
  value = data.aws_caller_identity.current.account_id
}

output "aws_caller_arn" {
  value = data.aws_caller_identity.current.arn
}

output "aws_region" {
  description = "AWS region where Terraform is operating"
  value       = data.aws_region.current.region
}

output "availability_zones" {
  description = "Available Availability Zones in the current region"
  value       = data.aws_availability_zones.available.names
}

output "common_tags" {
  value = local.common_tags
}



# networking module outs
# these expose  values generated by the  networking child module
# to the root environment


output "vpc_id" {
  description = "ID of the main VPC"
  value       = module.networking.vpc_id
}

output "vpc_cidr_block" {
  description = "CIDR Bloc kassigned to the main VPC"
  value       = module.networking.vpc_cidr_block
}

output "main_route_table_id" {
  description = "Main route table of the VPC"
  value       = module.networking.main_route_table_id
}